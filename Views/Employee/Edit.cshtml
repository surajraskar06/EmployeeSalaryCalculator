@model TblEmployeeSalary
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/MyLayout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">

            @using (Html.BeginForm())
            {
                @Html.HiddenFor(e => e.EmployeeId)

                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h4>Edit Employee</h4>
                    </div>

                    <div class="card-body">

                        <div class="mb-3">
                            <label>Employee Name</label>
                            @Html.TextBoxFor(e => e.EmployeeName, new { @class = "form-control" })
                        </div>

                        <div class="mb-3">
                            <label>Department</label>
                            @Html.TextBoxFor(e => e.Department, new { @class = "form-control" })
                        </div>

                        <div class="mb-3">
                            <label>Designation</label>
                            @Html.TextBoxFor(e => e.Designation, new { @class = "form-control" })
                        </div>

                        <div class="mb-3">
                            <label>Basic Salary</label>
                            @Html.TextBoxFor(e => e.BasicSalary, new
                            {
                                @class = "form-control",
                                type = "number",
                                step = "0.01"
                            })
                        </div>

                    </div>

                    <div class="card-footer">
                        <input type="submit" value="Update" class="btn btn-success" />
                        <a href="/Employee/Index" class="btn btn-secondary">Back</a>
                    </div>

                </div>
            }

        </div>
    </div>
</div>
